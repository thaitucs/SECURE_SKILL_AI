# .env.example - copy to .env and fill in real values.
# Commit THIS file. Never commit .env.
# Variables with a public prefix (NEXT_PUBLIC_, VITE_, REACT_APP_, EXPO_PUBLIC_, PUBLIC_ ...)
# are bundled into the frontend: put ONLY public values there.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# --- Backend secrets (server only) ---
SESSION_SECRET=
JWT_SECRET=

# --- Database branch ---
DATABASE_URL=
# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# --- File storage branch ---
STORAGE_DRIVER=local            # local | s3 | gcs | azure | cloudinary | supabase
STORAGE_LOCAL_PATH=../storage   # outside the web root
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=                    # for R2 / MinIO / B2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300
UPLOAD_MAX_BYTES=5242880

# --- Email (contact form) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=                     # recipient - fixed on the server, never from the form

# --- Anti-spam ---
TURNSTILE_SITE_KEY=             # public (also exposed to frontend with the public prefix)
TURNSTILE_SECRET_KEY=           # server only
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_MAX=5

# --- Frontend (public!) ---
# VITE_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
